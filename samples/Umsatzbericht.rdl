<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Vertrieb">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=Vertrieb</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>5b2f0c1e-3a43-4f5e-9c39-0f0d7e3c2a11</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Umsaetze">
      <Query>
        <DataSourceName>Vertrieb</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Jahr">
            <Value>=Parameters!Jahr.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Region, Kunde, Bestelldatum, Menge, Umsatz
FROM dbo.Bestellungen
WHERE YEAR(Bestelldatum) = @Jahr</CommandText>
      </Query>
      <Fields>
        <Field Name="Region"><DataField>Region</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Kunde"><DataField>Kunde</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Bestelldatum"><DataField>Bestelldatum</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Menge"><DataField>Menge</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Umsatz"><DataField>Umsatz</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Durchschnittspreis"><Value>=Fields!Umsatz.Value / Fields!Menge.Value</Value><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Titel">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
